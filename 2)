#include <stdio.h>

int main() {
    char word[] = "yellow";
    char result[4];
    int start = 3; // Индекс 'l' в "yellow"
    int end = 6;   // Индекс после 'w'
    int j = 0;
    
    for (int i = start; i < end; i++) {
        result[j++] = word[i];
    }
    result[j] = '\0'; 
    
    printf("Результат: %s\n", result);
    
    return 0;
}
